# Copy this file to .env.local for local development. Never commit .env or .env.local.

# --- Phase A/B: placeholder entitlement gate ---
# Passphrase that stands in for "has purchased" until real auth (Phase C) exists.
# Anyone who enters this at /unlock is treated as entitled to every profile.
PLACEHOLDER_ACCESS_CODE=letmein

# Number of players (by overallRank) visible to everyone with no entitlement at all.
FREE_PLAYER_LIMIT=30

