# Copy this file to .env.local for local development. Never commit .env or .env.local.

# --- Phase A/B: placeholder entitlement gate ---
# Passphrase that stands in for "has purchased" until real auth (Phase C) exists.
# Anyone who enters this at /unlock is treated as entitled to every profile.
PLACEHOLDER_ACCESS_CODE=letmein

# Number of players (by overallRank) visible to everyone with no entitlement at all.
FREE_PLAYER_LIMIT=30

# --- Phase B: Google Sheets sync ---
# From the service account JSON key (see README "Google Sheets service
# account setup"). PRIVATE_KEY keeps its \n sequences literal (don't
# convert them to real line breaks) and stays wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The long id in the sheet's URL: .../spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# The gid= query param from the URL of the specific tab you use as the
# "which position tabs to read" anchor -- currently unused (sync-sheet.mjs
# reads all position tabs by name), kept for reference.
# GOOGLE_SHEET_GID=

# --- Phase B: publish trigger (not used yet) ---
# NETLIFY_BUILD_HOOK_URL=
# PUBLISH_NOW_SECRET=

# --- Phase C: store + auth (not used yet) ---
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_API_KEY=
# AUTH_EMAIL_FROM=
# AUTH_EMAIL_SERVER=
# AUTH_SECRET=
# DATABASE_URL=
